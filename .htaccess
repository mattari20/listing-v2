# V2 repository-root web entry for Hostinger subfolder deployment.
# The deployment directory is the repository root; Laravel's public document
# files live in ./public. Keep private application directories inaccessible.

Options -Indexes -MultiViews
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Do not expose repository metadata, dotfiles, or private Laravel sources.
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.github(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|scripts|docs)(?:/|$) - [F,L,NC]

    # Internal requests already mapped into public/ must reach its Laravel
    # .htaccess without being prefixed a second time.
    RewriteRule ^public/ - [L]

    # Serve only files/directories that exist in Laravel's public tree.
    RewriteCond %{DOCUMENT_ROOT}/institutes-v2/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/institutes-v2/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # All remaining application requests go through Laravel's front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>

# Never serve environment files, Composer metadata, or lockfiles.
<FilesMatch "^(?:\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
