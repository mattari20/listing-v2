APP_NAME="eStudent Institutes V2"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Local/CI remains SQLite. For the separately provisioned hosted V2 database,
# set DB_CONNECTION=mysql and provide the dedicated V2 database credentials.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=warning

CACHE_STORE=array
SESSION_DRIVER=array
SESSION_COOKIE=estudent-institutes-v2-session
# For a hosted subfolder such as /v2, set SESSION_PATH to that exact URL path.
# Keep / for local root-path development.
SESSION_PATH=/
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Private preview is disabled by default. Enable only for an explicitly
# protected private environment and set a unique username/password outside Git.
PRIVATE_PREVIEW_ENABLED=false
PRIVATE_PREVIEW_USERNAME=
PRIVATE_PREVIEW_PASSWORD=
